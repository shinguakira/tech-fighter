# オンライン対戦のシグナリング用 Redis（Upstash / Vercel Storage 統合）。
#
# Vercel ダッシュボード → プロジェクト → Storage タブ → Redis（Upstash）を接続すると
# 本番には自動で注入される。ローカル dev で同じ値を使うには:
#   npx vercel env pull .env.local
#
# 変数名は Upstash 純正 / Vercel KV 由来のどちらでも良い（fromEnv が両対応）。
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
